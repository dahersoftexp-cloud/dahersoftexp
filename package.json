{
  "name": "express-server-template",
  "version": "1.0.0",
  "main": "src/server.ts",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "nodemon src/server.ts",
    "test:return": "npm run build && node --test tests/saleReturn.test.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:warehouse:emulator": "npm run build && node --test tests/emulator/warehouse.test.js",
    "emulators:warehouse": "node scripts/run-warehouse-emulator.cjs",
    "audit:source": "node scripts/audit-source.cjs",
    "audit:backup": "node scripts/audit-backup.cjs",
    "staging:preflight": "npm run build && node scripts/staging-preflight.cjs",
    "test:smoke:local": "node tests/live-api-smoke.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase": "^11.9.1",
    "google-auth-library": "11.3.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.4.2",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
